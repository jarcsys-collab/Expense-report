# Used only by `npm run dev` (Vite development mode). Production and GitHub Pages
# builds (`npm run build`, `npm run build:pages`) do not read this file.
# No secrets here: everything in VITE_* is visible in the browser.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_RECEIPT_UPLOAD_ENABLED=true
# Microsoft Entra ID sign-in. Empty = off locally (only the beta sign-in shows).
# To try it locally, add http://localhost:5173/ as a Single-page application
# redirect URI on the app registration, then fill these in.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/
