# Used only by `npm run build:pages` (the GitHub Pages build written to site/).
# Local development uses .env.development (http://localhost:3000/api).
# No secrets here: everything in VITE_* is visible in the browser.
VITE_API_BASE_URL=https://expense-report-production-9a89.up.railway.app/api
# Controlled beta: receipt upload is enabled; OCR only runs when someone uploads a receipt.
VITE_RECEIPT_UPLOAD_ENABLED=true
# Microsoft Entra ID sign-in (MSAL, authorization code + PKCE). Public identifiers,
# not secrets; the SPA has no client secret. The redirect URI must match the
# app registration's Single-page application redirect URI exactly.
VITE_ENTRA_CLIENT_ID=92e8f33d-6e27-4763-b638-7d7959c2ddc9
VITE_ENTRA_TENANT_ID=dfc22d3a-9773-49e8-b017-a5d7a5fee3dd
VITE_ENTRA_REDIRECT_URI=https://jarcsys-collab.github.io/Expense-report/
