# Copy to .env.local for local development. Every VITE_* value is compiled
# into the public JavaScript bundle: never put secrets, API keys or database
# URLs here. Secrets (MongoDB Atlas, Veryfi) belong only on the backend.

# Base URL of the Node.js/Express API, including the /api prefix.
#   local:      VITE_API_BASE_URL=http://localhost:3000/api
#   production: VITE_API_BASE_URL=https://<your-api-host>/api   (must be https)
# Leave empty to run without a backend (the app shows "Workspace service is not configured").
VITE_API_BASE_URL=

# Route style: "rest" (/expenses, /receipts/upload, ...) or "n8n" (/webhook/*).
VITE_API_STYLE=rest

# fetch() credentials mode for API calls: include | same-origin | omit
VITE_API_CREDENTIALS=include

# Organization sign-in page used by the Profile > Sign in button.
VITE_SIGN_IN_URL=

# Microsoft Entra ID sign-in (MSAL, authorization code + PKCE). Public identifiers,
# not secrets: Application (client) ID and Directory (tenant) ID from the app
# registration. Never add a client secret to the frontend. Leave the IDs empty to
# turn Microsoft sign-in off. The redirect URI must be registered on the app
# registration as a Single-page application redirect URI.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=

# Keep false until POST /receipts/upload is implemented on the backend.
VITE_RECEIPT_UPLOAD_ENABLED=false

# Optional tuning (milliseconds).
# VITE_OCR_POLL_INTERVAL_MS=2500
# VITE_OCR_TIMEOUT_MS=180000
# VITE_REQUEST_TIMEOUT_MS=30000

# Optional per-endpoint path overrides, e.g.
# VITE_SAVE_CATEGORY_PATH=/categories/{id}
