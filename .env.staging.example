# Copy to .env.staging.local (git-ignored) and fill in, then: npm run build:staging
# Public values only: everything in VITE_* is visible in the browser. No secrets here.
# The build refuses production's values (scripts/checkStagingEnv.mjs).
VITE_APP_NAME=ReceiptFlow STAGING
VITE_API_BASE_URL=https://<staging-api-host>/api
VITE_RECEIPT_UPLOAD_ENABLED=true
# From the separate "ReceiptFlow Staging" app registration (not production's).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=https://<staging-frontend-host>/
