# Variables for the STAGING Railway service. A reference only: set them in Railway, never
# in a committed file. staging-server.js refuses to start if the safety settings are wrong.

# Isolation (required)
NODE_ENV=production
TRUST_PROXY=1
# Dedicated user, limited to this database, on a cluster separate from production.
MONGODB_URI=
MONGODB_DB_NAME=receiptflow-staging
FRONTEND_ORIGIN=https://<staging-frontend-host>

# Microsoft sign-in: the separate "ReceiptFlow Staging" app registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Must stay off (staging refuses to start otherwise). They default to off when unset.
APPROVAL_WORKFLOW_ENABLED=false
RECEIPT_CLEANUP_ENABLED=false
NOTIFICATIONS_ENABLED=false
BETA_AUTH_ENABLED=false
DEV_AUTH_ENABLED=false

# OCR. stub (default): nothing is sent to Google, and every scan reads as one synthetic
# receipt. No Google variables are needed. real: billable, and needs written approval;
# see docs/staging.md.
STAGING_OCR_MODE=stub
