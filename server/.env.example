# Copy to server/.env (never commit it).
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string from Atlas > Database > Connect > Drivers.
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB_NAME=receiptflow

# Comma-separated browser origins allowed to call the API (exact match, no wildcards).
# https://jarcsys-collab.github.io is always allowed; http://localhost:5173 is
# allowed automatically outside production.
FRONTEND_ORIGIN=http://localhost:5173

# Development-only stand-in for organization sign-in: GET /api/auth/session
# returns this user so the frontend can load data locally. Ignored when
# NODE_ENV=production.
DEV_AUTH_ENABLED=false
DEV_AUTH_ROLE=FINANCE_ADMIN

# Set to the number of reverse proxies in front of the API when deployed
# (e.g. 1 on Render/Railway) so rate limiting sees real client IPs.
TRUST_PROXY=0

# Veryfi OCR (backend only; never put these in VITE_* or frontend code).
# From Veryfi Hub > Settings > Keys. All four are required to enable OCR:
# Client ID + username + API key authenticate requests; the client secret signs them.
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=
VERYFI_BASE_URL=https://api.veryfi.com
VERYFI_TIMEOUT_SECONDS=90

# OCR provider that reads receipts: veryfi | google_document_ai ("google" also works).
# Switching back to veryfi is the rollback; both configurations can stay set.
OCR_PROVIDER=veryfi

# Google Cloud Document AI Expense Parser (backend only; never in VITE_* or frontend code).
GOOGLE_DOCUMENT_AI_PROJECT_ID=
# Processor region, e.g. us, eu or asia-southeast1 (endpoint <location>-documentai.googleapis.com).
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Optional: pin a processor version; empty uses the processor's default version.
GOOGLE_DOCUMENT_AI_PROCESSOR_VERSION=
# Service-account key. Use ONE of:
#  - Production (Railway): GOOGLE_DOCUMENT_AI_CREDENTIALS_JSON as a SEALED variable holding
#    the whole key file (raw JSON or base64). Takes precedence when both are set.
#  - Local development: GOOGLE_APPLICATION_CREDENTIALS = path to the key file, kept in
#    server/secrets/ (git-ignored). Never commit key files.
GOOGLE_DOCUMENT_AI_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCUMENT_AI_TIMEOUT_SECONDS=60

# Manager Approval / Finance routing on submit. false (default): a checked request
# is saved to My Requests as "Pending Workflow Setup" and routed nowhere. Turning
# it on routes only requests submitted afterwards; saved ones wait for the
# employee to submit them again. Server-only: the browser cannot change it.
APPROVAL_WORKFLOW_ENABLED=false

# A changed scanned total is flagged for review unless within BOTH limits.
# 0 = every change is flagged (default). Set only with Finance's approval.
OCR_TOTAL_CORRECTION_TOLERANCE_AMOUNT=0
OCR_TOTAL_CORRECTION_TOLERANCE_PERCENT=0

# Ambiguous numeric receipt dates (e.g. 10/03/2026): DMY = day/month (Philippines), MDY = month/day.
# Ambiguous dates are suggested in this order and must be confirmed by the employee.
RECEIPT_DATE_ORDER=DMY

# Microsoft Entra ID sign-in (primary). Public identifiers, not secrets; no client
# secret is needed: the API verifies the Microsoft ID token's signature with the
# tenant's public signing keys. Both must match the frontend's VITE_ENTRA_* values.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# ReceiptFlow session lifetime after Microsoft sign-in, in hours.
ENTRA_SESSION_HOURS=8

# TEMPORARY controlled-beta sign-in, a fallback while Microsoft sign-in is verified.
# Set real values only in Railway Variables (or your local server/.env), never in frontend code.
# Requires BETA_AUTH_ENABLED=true, a username and a password of at least 12 characters.
BETA_AUTH_ENABLED=false
BETA_AUTH_USERNAME=
BETA_AUTH_PASSWORD=
# Role shown to the beta account: EMPLOYEE | APPROVER | FINANCE_ADMIN
BETA_AUTH_ROLE=EMPLOYEE
# Session lifetime in hours.
BETA_SESSION_HOURS=12

# Anomaly notifications. Off by default: rules can be set up in Management, but nothing
# is queued or delivered until this is true. Separate from approval routing.
NOTIFICATIONS_ENABLED=false
# Email is not connected. "mock" records only, and is ignored in production.
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_WORKER_INTERVAL_SECONDS=30

# OCR cost ESTIMATES for the Management dashboard, not actual billing. Google Document AI
# Expense Parser list price, checked 2026-11-09 at
# https://cloud.google.com/products/document-ai/pricing : USD 0.10 per count, where
# 1 count = up to 10 pages of a document. Change these if your agreed price differs.
OCR_COST_GOOGLE_USD_PER_UNIT=0.10
OCR_COST_GOOGLE_PAGES_PER_UNIT=10
# Veryfi price per document, from your contract. 0 = no estimate is shown.
OCR_COST_VERYFI_USD_PER_DOCUMENT=0
# Estimated monthly spend that raises a dashboard alert. 0 = no alert.
OCR_MONTHLY_BUDGET_USD=0
# An identical file from the SAME account within this many days reuses the earlier reading
# instead of a new OCR request. Never across accounts. 0 = only the short retry window.
OCR_REUSE_PRIOR_SCAN_DAYS=30
